#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Tests create disposable repositories; do not pass this hook's Git context.
unset $(git rev-parse --local-env-vars)

head=$(git rev-parse HEAD)
updates=false
while read -r local_ref local_oid remote_ref remote_oid; do
  # Deleting refs publishes no new code and needs no build validation.
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  updates=true
  commit=$(git rev-parse --verify "$local_oid^{commit}")
  if [ "$commit" != "$head" ]; then
    printf '%s\n' "Cannot validate $local_ref: check out its commit before pushing." >&2
    exit 1
  fi
done
[ "$updates" = true ] || exit 0

require_clean_checkout() {
  status=$(git status --porcelain --untracked-files=all)
  if [ -n "$status" ]; then
    printf '%s\n' 'Push checks require a clean checkout. Commit or preserve pending changes first.' >&2
    exit 1
  fi
  current_head=$(git rev-parse HEAD)
  if [ "$current_head" != "$head" ]; then
    printf '%s\n' 'HEAD changed during push checks; retry from the commit being pushed.' >&2
    exit 1
  fi
}
require_clean_checkout
bash scripts/check.sh push
require_clean_checkout
