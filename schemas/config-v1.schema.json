{
  "$defs": {
    "identity": {
      "additionalProperties": false,
      "properties": {
        "dev": {
          "minimum": 0,
          "type": "integer"
        },
        "ino": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dev",
        "ino"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admin_identity": {
      "$ref": "#/$defs/identity"
    },
    "capacity": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "cleanup_policy": {
      "enum": [
        "pristine",
        "warm"
      ]
    },
    "execution_locks": {
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      },
      "propertyNames": {
        "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$",
        "type": "string"
      },
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096
    },
    "schema_version": {
      "const": 1
    },
    "slots": {
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      },
      "maxProperties": 4096,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$",
        "type": "string"
      },
      "type": "object"
    },
    "worktree_root": {
      "pattern": "^/",
      "type": "string"
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_target",
        "idle_timeout",
        "ready_base"
      ],
      "properties": {
        "ready_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "idle_timeout": {
          "type": "string",
          "pattern": "^(never|[1-9][0-9]*[smhd])$"
        },
        "ready_base": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ready_lock": {
      "$ref": "#/$defs/identity"
    }
  },
  "required": [
    "admin_identity",
    "capacity",
    "cleanup_policy",
    "execution_locks",
    "schema_version",
    "slots",
    "worktree_root"
  ],
  "title": "Groove ready manifest v1/v2/v3/v4/v5",
  "type": "object",
  "dependentRequired": {
    "ready": [
      "ready_lock"
    ]
  }
}
