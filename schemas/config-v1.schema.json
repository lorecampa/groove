{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Groove ready manifest v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capacity",
    "cleanup_policy",
    "worktree_root",
    "admin_identity",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "cleanup_policy": {
      "enum": [
        "pristine",
        "warm"
      ]
    },
    "worktree_root": {
      "type": "string",
      "pattern": "^/"
    },
    "admin_identity": {
      "$ref": "#/$defs/identity"
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino"
      ],
      "properties": {
        "dev": {
          "type": "integer",
          "minimum": 0
        },
        "ino": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
