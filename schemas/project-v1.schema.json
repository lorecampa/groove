{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lorecampa/groove/schemas/project-v1.schema.json",
  "title": "Groove project configuration v1 (TOML data model)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1, "default": 1},
    "experimental": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "default": []}
      },
      "description": "Individually requested features. Core rejects unknown or removed names; stabilized names remain accepted. No features are currently registered."
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "port_base": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "setup": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/setup"}},
    "recipes": {"$ref": "#/$defs/commands"},
    "agents": {"$ref": "#/$defs/commands"},
    "caches": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/cache"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "setup": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cache": {"type": ["string", "null"]},
        "steps": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "command"],
          "properties": {
            "name": {"$ref": "#/$defs/name"}, "command": {"$ref": "#/$defs/argv"},
            "timeout_ms": {"type": "integer", "minimum": 0, "default": 600000},
            "when": {"enum": ["always", "cache_miss"], "default": "always"}
          }
        }}
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false, "required": ["paths", "inputs", "key"],
      "properties": {
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "key": {"type": "string", "minLength": 1},
        "mode": {"enum": ["copy", "reflink"], "default": "copy"},
        "max_bytes": {"type": "integer", "minimum": 1, "default": 21474836480},
        "max_files": {"type": "integer", "minimum": 1, "default": 1000000}
      }
    },
    "commands": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["command"],
      "properties": {
        "command": {"$ref": "#/$defs/argv"},
        "requires_setup": {"type": ["string", "null"]},
        "timeout_ms": {"type": "integer", "minimum": 0, "default": 600000}
      }
    }}
  },
  "$comment": "Core additionally validates path containment, ignored/tracked membership, cache overlap, environment names, referenced profiles, argv limits and setup step uniqueness. No project command executes on configuration read."
}
