{
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        }
      }
    },
    "pool_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "pools_result": {
      "type": "object",
      "required": [
        "pools",
        "pagination"
      ],
      "properties": {
        "pools": {
          "type": "array",
          "description": "Repository pools, excluding deleted pools unless pools --all is requested. Interrupted pools remain visible.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pool_id",
              "phase",
              "state_dir",
              "capacity",
              "cleanup_policy",
              "workspace_root"
            ],
            "properties": {
              "storage": {
                "description": "Present with pools --disk-usage. Logical bytes; null for interrupted pools whose storage cannot be inspected.",
                "anyOf": [
                  {
                    "$ref": "#/$defs/storage_usage"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "$ref": "#/$defs/pool_name"
              },
              "pool_id": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phase": {
                "enum": [
                  "initializing",
                  "ready",
                  "deleting",
                  "deleted"
                ]
              },
              "state_dir": {
                "type": "string",
                "pattern": "^/"
              },
              "capacity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 4096
              },
              "cleanup_policy": {
                "enum": [
                  "pristine",
                  "warm",
                  null
                ]
              },
              "workspace_root": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^/"
              }
            }
          }
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      }
    },
    "destruction_result": {
      "type": "object",
      "required": [
        "destruction"
      ],
      "properties": {
        "destruction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pool_id",
            "dry_run",
            "deleted",
            "already_deleted",
            "resumed",
            "state_dir",
            "workspace_root",
            "slots",
            "artifacts"
          ],
          "properties": {
            "pool_name": {
              "$ref": "#/$defs/pool_name"
            },
            "pool_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dry_run": {
              "type": "boolean"
            },
            "deleted": {
              "type": "boolean"
            },
            "already_deleted": {
              "type": "boolean"
            },
            "resumed": {
              "type": "boolean"
            },
            "state_dir": {
              "type": "string",
              "pattern": "^/"
            },
            "workspace_root": {
              "type": "string",
              "pattern": "^/"
            },
            "slots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/slot"
              }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      }
    },
    "error": {
      "properties": {
        "hint": {
          "type": "string",
          "description": "Optional advisory recovery guidance; clients branch on code, not this text."
        },
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNSUPPORTED_CONFIGURATION",
            "POOL_EXHAUSTED",
            "ACQUIRE_TIMEOUT",
            "NOT_INITIALIZED",
            "CONFIG_CONFLICT",
            "INVALID_REVISION",
            "INVALID_RESERVATION",
            "RESERVATION_MISMATCH",
            "RECOVERY_FAILED",
            "POOL_UNHEALTHY",
            "IO_ERROR",
            "GIT_ERROR",
            "PROTOCOL_ERROR",
            "UNSAVED_CHANGES",
            "WORKSPACE_IN_USE"
          ]
        },
        "details": {
          "type": "object",
          "properties": {
            "setting": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "origin"],
              "properties": {
                "key": {"type": "string"},
                "value": {"type": "string"},
                "origin": {"type": "string"}
              }
            },
            "path": {
              "type": "string"
            },
            "git": {
              "type": "object",
              "required": [
                "exit_code",
                "stdout",
                "stderr",
                "output_truncated"
              ],
              "properties": {
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                },
                "output_truncated": {
                  "type": "boolean"
                }
              }
            },
            "capacity": {
              "type": "object",
              "required": [
                "capacity",
                "busy_slots",
                "failed_slots"
              ],
              "properties": {
                "capacity": {
                  "type": "integer"
                },
                "busy_slots": {
                  "type": "integer"
                },
                "failed_slots": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "reservation_id": {
              "$ref": "#/$defs/uuid"
            },
            "workspace_path": {
              "type": "string"
            },
            "released": {
              "type": "boolean"
            },
            "snapshot_id": {
              "$ref": "#/$defs/uuid"
            },
            "safety_snapshot_id": {
              "$ref": "#/$defs/uuid"
            },
            "secondary_error": {
              "type": "string"
            },
            "changes": {
              "type": "object",
              "required": [
                "staged",
                "modified",
                "untracked"
              ],
              "properties": {
                "staged": {
                  "type": "boolean"
                },
                "modified": {
                  "type": "boolean"
                },
                "untracked": {
                  "type": "boolean"
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "pid",
                  "command",
                  "uses"
                ],
                "properties": {
                  "pid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "command": {
                    "type": "string"
                  },
                  "uses": {
                    "enum": [
                      "working_directory",
                      "executable",
                      "open_file"
                    ]
                  }
                }
              }
            },
            "upgrade": {
              "$ref": "#/$defs/upgrade_result"
            }
          },
          "additionalProperties": false
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "type": "object"
    },
    "release_result": {
      "description": "Release of an explicitly selected reservation, or the active reservation inferred from a registered workspace. Errors after selection include details.reservation_id for an explicit retry.",
      "type": "object",
      "required": [
        "release",
        "snapshot"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/release"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/snapshot"
            }
          ]
        }
      }
    },
    "init": {
      "properties": {
        "pool_name": {
          "$ref": "#/$defs/pool_name"
        },
        "capacity": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "common_git_dir": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/slot"
          },
          "type": "array",
          "uniqueItems": true
        },
        "state_dir": {
          "type": "string"
        },
        "workspace_root": {
          "type": "string"
        },
        "ready_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "idle_timeout": {
          "type": "string",
          "pattern": "^(never|[1-9][0-9]*[smhd])$"
        },
        "ready_git_timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "ready_base": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "created",
        "common_git_dir",
        "state_dir",
        "capacity",
        "slots",
        "cleanup_policy",
        "workspace_root"
      ],
      "type": "object"
    },
    "slot_result": {
      "type": "object",
      "required": [
        "slot"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/inspection_result/properties/inspection/properties/slots/items"
        }
      }
    },
    "inspection_result": {
      "properties": {
        "storage": {
          "description": "Present with show --disk-usage in the pool view; logical bytes, excluding shared Git objects and snapshots.",
          "$ref": "#/$defs/storage_usage"
        },
        "inspection": {
          "properties": {
            "capacity": {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            "slots": {
              "items": {
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "git": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "staged",
                          "modified",
                          "untracked",
                          "error"
                        ],
                        "properties": {
                          "staged": {
                            "type": "boolean"
                          },
                          "modified": {
                            "type": "boolean"
                          },
                          "untracked": {
                            "type": "boolean"
                          },
                          "error": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "failure": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reservation": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/reservation"
                      }
                    ]
                  },
                  "lock_held": {
                    "type": "boolean"
                  },
                  "reservation_active": {
                    "type": "boolean"
                  },
                  "slot_id": {
                    "$ref": "#/$defs/slot"
                  },
                  "status": {
                    "enum": [
                      "available",
                      "reserved",
                      "locked",
                      "quarantined",
                      "unhealthy"
                    ]
                  },
                  "workspace_path": {
                    "type": "string"
                  }
                },
                "required": [
                  "slot_id",
                  "status",
                  "workspace_path",
                  "reservation",
                  "lock_held",
                  "failure"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "capacity",
            "slots"
          ],
          "type": "object"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "ready": {
          "$ref": "#/$defs/ready_report"
        }
      },
      "required": [
        "inspection",
        "pagination"
      ],
      "type": "object"
    },
    "reservation": {
      "properties": {
        "pool": {
          "$ref": "#/$defs/pool_name",
          "description": "Owning pool namespace when returned by repository-wide listing."
        },
        "acquired_at_unix_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "base_oid": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "head_mode": {
          "const": "detached"
        },
        "reservation_id": {
          "$ref": "#/$defs/uuid"
        },
        "recovery": {
          "enum": [
            "created",
            "sanitized",
            "rebuilt"
          ]
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "requested_base": {
          "type": "string"
        },
        "slot_id": {
          "$ref": "#/$defs/slot"
        },
        "task": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "workspace_path": {
          "type": "string"
        },
        "ownership": {
          "enum": [
            "in_process",
            "durable"
          ]
        }
      },
      "required": [
        "slot_id",
        "reservation_id",
        "workspace_path",
        "base_oid",
        "head_mode",
        "recovery",
        "cleanup_policy",
        "ownership"
      ],
      "type": "object"
    },
    "reservations": {
      "properties": {
        "reservations": {
          "items": {
            "$ref": "#/$defs/reservation"
          },
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      },
      "required": [
        "reservations",
        "pagination"
      ],
      "type": "object"
    },
    "policy": {
      "enum": [
        "pristine",
        "warm"
      ]
    },
    "release": {
      "properties": {
        "cleanup": {
          "const": "deferred"
        },
        "reservation_id": {
          "$ref": "#/$defs/uuid"
        },
        "released": {
          "const": true
        },
        "slot_id": {
          "$ref": "#/$defs/slot"
        }
      },
      "required": [
        "slot_id",
        "reservation_id",
        "released",
        "cleanup"
      ],
      "type": "object"
    },
    "slot": {
      "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$",
      "type": "string"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "minimum": 0,
          "type": "integer"
        },
        "created_at_ns": {
          "minimum": 0,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "index_tree": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "pinned": {
          "type": "boolean"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "untracked_blob": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "work_tree": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "id",
        "created_at",
        "created_at_ns",
        "description",
        "workspace",
        "branch",
        "head",
        "index_tree",
        "work_tree",
        "untracked_blob",
        "session",
        "pinned"
      ],
      "type": "object"
    },
    "snapshot_result": {
      "anyOf": [
        { "$ref": "#/$defs/snapshot_prune_result" },
        { "$ref": "#/$defs/snapshot_storage_result" },
        {
          "$ref": "#/$defs/snapshot_one_result"
        },
        {
          "$ref": "#/$defs/snapshots_result"
        },
        {
          "$ref": "#/$defs/snapshot_diff_result"
        },
        {
          "$ref": "#/$defs/snapshot_restore_result"
        },
        {
          "$ref": "#/$defs/snapshot_delete_result"
        }
      ]
    },
    "text": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "user_config": {
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "experimental": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "features": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                }
              },
              "required": [
                "features"
              ]
            },
            "worktrees": {
              "type": "object",
              "properties": {
                "root": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^/"
                }
              },
              "required": [
                "root"
              ],
              "additionalProperties": false
            },
            "logging": {
              "type": "object",
              "properties": {
                "level": {
                  "enum": [
                    "error",
                    "warn",
                    "info",
                    "debug",
                    "trace"
                  ]
                }
              }
            },
            "updates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check"
              ],
              "properties": {
                "check": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "config_path": {
          "type": "string"
        },
        "environment_overrides": {
          "type": "object"
        },
        "updated": {
          "const": true
        }
      },
      "required": [
        "config_path"
      ],
      "type": "object"
    },
    "uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "pool_settings": {
      "type": "object",
      "properties": {
        "pool_name": {
          "$ref": "#/$defs/pool_name"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "workspace_root": {
          "type": "string"
        },
        "state_dir": {
          "type": "string"
        },
        "ready_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "idle_timeout": {
          "type": "string",
          "pattern": "^(never|[1-9][0-9]*[smhd])$"
        },
        "ready_git_timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "ready_base": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "capacity",
        "cleanup_policy",
        "workspace_root",
        "state_dir"
      ],
      "additionalProperties": false
    },
    "pool_result": {
      "type": "object",
      "properties": {
        "pool": {
          "$ref": "#/$defs/pool_settings"
        },
        "updated": {
          "type": "boolean"
        }
      },
      "required": [
        "pool"
      ],
      "not": {
        "required": [
          "inspection"
        ]
      }
    },
    "reservation_result": {
      "type": "object",
      "required": [
        "reservation"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "reservation": {
          "$ref": "#/$defs/reservation"
        },
        "slot": {
          "type": "object"
        }
      }
    },
    "snapshot_one_result": {
      "type": "object",
      "required": [
        "snapshot"
      ],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "snapshot_prune_result": {
      "type": "object",
      "required": ["prune"],
      "additionalProperties": false,
      "properties": {
        "prune": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "selected", "deleted", "retained"],
          "properties": {
            "applied": { "type": "boolean" },
            "selected": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
            "deleted": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
            "retained": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "reason"],
                "properties": {
                  "id": { "$ref": "#/$defs/uuid" },
                  "reason": { "enum": ["pinned", "protected_workspace", "keep_last", "too_recent"] }
                }
              }
            }
          }
        }
      }
    },
    "snapshot_storage_result": {
      "type": "object",
      "required": ["storage"],
      "properties": { "storage": { "$ref": "#/$defs/snapshot_storage" } }
    },
    "snapshot_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshots", "pinned", "oldest_created_at", "newest_created_at", "repository_objects", "largest_limit", "largest_blobs"],
      "properties": {
        "snapshots": { "type": "integer", "minimum": 0 },
        "pinned": { "type": "integer", "minimum": 0 },
        "oldest_created_at": { "type": ["integer", "null"], "minimum": 0 },
        "newest_created_at": { "type": ["integer", "null"], "minimum": 0 },
        "repository_objects": {
          "type": "object",
          "description": "Local repository-wide Git storage, excluding alternates. Rounded KiB measurements converted to bytes, not exact disk, snapshot-attributable or reclaimable bytes.",
          "additionalProperties": false,
          "required": ["loose_objects", "loose_bytes", "packed_objects", "packed_bytes", "packs"],
          "properties": {
            "loose_objects": { "type": "integer", "minimum": 0 },
            "loose_bytes": { "type": "integer", "minimum": 0, "multipleOf": 1024 },
            "packed_objects": { "type": "integer", "minimum": 0 },
            "packed_bytes": { "type": "integer", "minimum": 0, "multipleOf": 1024 },
            "packs": { "type": "integer", "minimum": 0 }
          }
        },
        "largest_limit": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "largest_blobs": {
          "type": "array", "maxItems": 1000,
          "description": "Unique blobs ordered by descending logical size then ascending OID; one deterministic representative occurrence, not exhaustive provenance.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["oid", "logical_bytes", "snapshot_id", "tree", "path"],
            "properties": {
              "oid": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "logical_bytes": { "type": "integer", "minimum": 0, "description": "Uncompressed blob length; not allocated or reclaimable bytes." },
              "snapshot_id": { "$ref": "#/$defs/uuid" },
              "tree": { "enum": ["index", "work"] },
              "path": { "type": "string", "description": "Representative Git path, displayed with replacement for invalid UTF-8 bytes." }
            }
          }
        }
      }
    },
    "snapshots_result": {
      "type": "object",
      "required": [
        "snapshots",
        "pagination"
      ],
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      }
    },
    "snapshot_diff_result": {
      "type": "object",
      "required": [
        "patch"
      ],
      "properties": {
        "patch_encoding": {
          "type": "string",
          "enum": [
            "base64"
          ],
          "description": "When present, decode patch from base64. Otherwise patch is UTF-8 text."
        },
        "patch": {
          "type": "string"
        }
      }
    },
    "snapshot_restore_result": {
      "type": "object",
      "required": [
        "path",
        "snapshot_id",
        "safety_snapshot_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "snapshot_id": {
          "$ref": "#/$defs/uuid"
        },
        "safety_snapshot_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuid"
            }
          ]
        }
      }
    },
    "snapshot_delete_result": {
      "type": "object",
      "required": [
        "deleted"
      ],
      "properties": {
        "deleted": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "storage_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_bytes",
        "history_bytes",
        "log_bytes",
        "runs",
        "untracked_log_bytes",
        "untracked_runs",
        "workspace_bytes"
      ],
      "properties": {
        "log_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "history_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "untracked_log_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "untracked_runs": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "workspace_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "offset",
        "limit",
        "next_offset"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ready_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_at_unix_ms",
        "running",
        "ready",
        "failures",
        "error"
      ],
      "properties": {
        "attempted_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "boolean"
        },
        "ready": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "failures": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pool_show_result": {
      "type": "object",
      "required": [
        "pool",
        "inspection",
        "ready",
        "pagination"
      ],
      "properties": {
        "pool": {
          "$ref": "#/$defs/pool_settings"
        },
        "inspection": {
          "properties": {
            "capacity": {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            "slots": {
              "items": {
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "git": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "staged",
                          "modified",
                          "untracked",
                          "error"
                        ],
                        "properties": {
                          "staged": {
                            "type": "boolean"
                          },
                          "modified": {
                            "type": "boolean"
                          },
                          "untracked": {
                            "type": "boolean"
                          },
                          "error": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "failure": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reservation": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/reservation"
                      }
                    ]
                  },
                  "lock_held": {
                    "type": "boolean"
                  },
                  "reservation_active": {
                    "type": "boolean"
                  },
                  "slot_id": {
                    "$ref": "#/$defs/slot"
                  },
                  "status": {
                    "enum": [
                      "available",
                      "reserved",
                      "locked",
                      "quarantined",
                      "unhealthy"
                    ]
                  },
                  "workspace_path": {
                    "type": "string"
                  }
                },
                "required": [
                  "slot_id",
                  "status",
                  "workspace_path",
                  "reservation",
                  "lock_held",
                  "failure"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "capacity",
            "slots"
          ],
          "type": "object"
        },
        "ready": {
          "$ref": "#/$defs/ready_report"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "storage": {
          "$ref": "#/$defs/storage_usage"
        }
      }
    },
    "upgrade_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ],
      "properties": {
        "program": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "upgrade_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "path",
        "current_version",
        "target_version",
        "update_available",
        "status",
        "message",
        "commands"
      ],
      "properties": {
        "name": {
          "enum": [
            "cli",
            "codex",
            "claude"
          ]
        },
        "source": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "update_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "up_to_date",
            "available",
            "planned",
            "upgraded",
            "skipped",
            "failed",
            "unchecked"
          ]
        },
        "message": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/upgrade_command"
          }
        }
      }
    },
    "upgrade_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "dry_run",
        "breaking_change",
        "release_notes",
        "components"
      ],
      "properties": {
        "check": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "breaking_change": {
          "type": "boolean"
        },
        "release_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/upgrade_component"
          }
        }
      }
    }
  },
  "$id": "https://github.com/lorecampa/groove/schemas/response-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/setting"
            },
            {
              "$ref": "#/$defs/destruction_result"
            },
            {
              "$ref": "#/$defs/pools_result"
            },
            {
              "$ref": "#/$defs/init"
            },
            {
              "$ref": "#/$defs/reservation"
            },
            {
              "$ref": "#/$defs/text"
            },
            {
              "$ref": "#/$defs/reservations"
            },
            {
              "$ref": "#/$defs/user_config"
            },
            {
              "$ref": "#/$defs/snapshot_result"
            },
            {
              "$ref": "#/$defs/inspection_result"
            },
            {
              "$ref": "#/$defs/slot_result"
            },
            {
              "$ref": "#/$defs/release_result"
            },
            {
              "$ref": "#/$defs/pool_result"
            },
            {
              "$ref": "#/$defs/reservation_result"
            },
            {
              "$ref": "#/$defs/pool_show_result"
            },
            {
              "$ref": "#/$defs/upgrade_result"
            }
          ]
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "api_version": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "api_version",
    "request_id",
    "ok"
  ],
  "title": "Groove CLI response v2",
  "type": "object",
  "x-groove-command-results": {
    "config get": [
      "setting"
    ],
    "pool get": [
      "setting"
    ],
    "acquire": [
      "reservation"
    ],
    "completions": [
      "text"
    ],
    "config set": [
      "user_config"
    ],
    "config show": [
      "user_config"
    ],
    "help": [
      "text"
    ],
    "list": [
      "reservations",
      "inspection_result"
    ],
    "release": [
      "release_result"
    ],
    "show": [
      "reservation_result",
      "slot_result"
    ],
    "snapshot delete": [
      "snapshot_delete_result"
    ],
    "snapshot diff": [
      "snapshot_diff_result"
    ],
    "snapshot list": [
      "snapshots_result"
    ],
    "snapshot storage": ["snapshot_storage_result"],
    "snapshot prune": ["snapshot_prune_result"],
    "snapshot restore": [
      "snapshot_restore_result"
    ],
    "snapshot save": [
      "snapshot_one_result"
    ],
    "snapshot show": [
      "snapshot_one_result"
    ],
    "version": [
      "text"
    ],
    "pool init": [
      "init"
    ],
    "pool list": [
      "pools_result"
    ],
    "pool show": [
      "pool_show_result"
    ],
    "pool set": [
      "pool_result"
    ],
    "pool destroy": [
      "destruction_result"
    ],
    "config path": [
      "user_config"
    ],
    "config edit": [
      "user_config"
    ],
    "config unset": [
      "user_config"
    ],
    "upgrade": [
      "upgrade_result"
    ]
  }
