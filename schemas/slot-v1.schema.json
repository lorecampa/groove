{
  "$defs": {
    "error": {
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNSUPPORTED_CONFIGURATION",
            "POOL_EXHAUSTED",
            "ACQUIRE_TIMEOUT",
            "NOT_INITIALIZED",
            "CONFIG_CONFLICT",
            "INVALID_REVISION",
            "INVALID_LEASE",
            "LEASE_MISMATCH",
            "RECOVERY_FAILED",
            "POOL_UNHEALTHY",
            "IO_ERROR",
            "GIT_ERROR",
            "PROTOCOL_ERROR"
          ]
        },
        "details": {
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "type": "object"
    },
    "init": {
      "properties": {
        "capacity": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "common_git_dir": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/slot"
          },
          "type": "array",
          "uniqueItems": true
        },
        "state_dir": {
          "type": "string"
        },
        "worktree_root": {
          "type": "string"
        }
      },
      "required": [
        "created",
        "common_git_dir",
        "state_dir",
        "capacity",
        "slots",
        "cleanup_policy",
        "worktree_root"
      ],
      "type": "object"
    },
    "lease": {
      "properties": {
        "acquired_at_unix_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "base_oid": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "head_mode": {
          "const": "detached"
        },
        "lease_id": {
          "$ref": "#/$defs/uuid"
        },
        "recovery": {
          "enum": [
            "created",
            "sanitized",
            "rebuilt"
          ]
        },
        "request_key": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "requested_base": {
          "type": "string"
        },
        "slot_id": {
          "$ref": "#/$defs/slot"
        },
        "task": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "worktree_path": {
          "type": "string"
        },
        "ownership": {
          "enum": [
            "in_process",
            "durable"
          ]
        }
      },
      "required": [
        "slot_id",
        "lease_id",
        "worktree_path",
        "base_oid",
        "head_mode",
        "recovery",
        "cleanup_policy",
        "ownership"
      ],
      "type": "object"
    },
    "policy": {
      "enum": [
        "pristine",
        "warm"
      ]
    },
    "release": {
      "properties": {
        "cleanup": {
          "const": "deferred"
        },
        "lease_id": {
          "$ref": "#/$defs/uuid"
        },
        "released": {
          "const": true
        },
        "slot_id": {
          "$ref": "#/$defs/slot"
        }
      },
      "required": [
        "slot_id",
        "lease_id",
        "released",
        "cleanup"
      ],
      "type": "object"
    },
    "slot": {
      "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$",
      "type": "string"
    },
    "text": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/lease"
        }
      ]
    },
    "phase": {
      "enum": [
        "available",
        "leased",
        "released",
        "quarantined"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "idle_since_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "released_head": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "lease",
    "failure"
  ],
  "title": "Groove slot record v1",
  "type": "object"
}
