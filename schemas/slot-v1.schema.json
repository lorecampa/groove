{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Groove slot record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "lease",
    "failure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "enum": [
        "available",
        "leased",
        "released",
        "quarantined"
      ]
    },
    "lease": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/lease"
        }
      ]
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "slot": {
      "type": "string",
      "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy": {
      "enum": [
        "pristine",
        "warm"
      ]
    },
    "init": {
      "type": "object",
      "required": [
        "created",
        "common_git_dir",
        "state_dir",
        "capacity",
        "slots",
        "cleanup_policy",
        "worktree_root"
      ],
      "properties": {
        "created": {
          "type": "boolean"
        },
        "common_git_dir": {
          "type": "string"
        },
        "state_dir": {
          "type": "string"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "uniqueItems": true
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "worktree_root": {
          "type": "string"
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "slot_id",
        "lease_id",
        "worktree_path",
        "base_oid",
        "head_mode",
        "recovery",
        "cleanup_policy",
        "lease_transport",
        "descriptor_count"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/slot"
        },
        "lease_id": {
          "$ref": "#/$defs/uuid"
        },
        "worktree_path": {
          "type": "string"
        },
        "base_oid": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head_mode": {
          "const": "detached"
        },
        "recovery": {
          "enum": [
            "created",
            "sanitized",
            "rebuilt"
          ]
        },
        "cleanup_policy": {
          "$ref": "#/$defs/policy"
        },
        "lease_transport": {
          "enum": [
            "scm_rights",
            "in_process",
            "durable_protection"
          ]
        },
        "descriptor_count": {
          "enum": [
            0,
            1
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lease_transport": {
                "const": "durable_protection"
              }
            }
          },
          "then": {
            "properties": {
              "descriptor_count": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "descriptor_count": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "required": [
        "slot_id",
        "lease_id",
        "released",
        "cleanup"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/slot"
        },
        "lease_id": {
          "$ref": "#/$defs/uuid"
        },
        "released": {
          "const": true
        },
        "cleanup": {
          "const": "deferred"
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNSUPPORTED_CONFIGURATION",
            "POOL_EXHAUSTED",
            "ACQUIRE_TIMEOUT",
            "NOT_INITIALIZED",
            "CONFIG_CONFLICT",
            "INVALID_REVISION",
            "INVALID_LEASE",
            "LEASE_MISMATCH",
            "RECOVERY_FAILED",
            "POOL_UNHEALTHY",
            "IO_ERROR",
            "GIT_ERROR",
            "PROTOCOL_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
