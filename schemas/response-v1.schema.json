{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lorecampa/groove/schemas/response-v1.schema.json",
  "title": "Groove CLI response v1",
  "type": "object",
  "required": ["api_version", "request_id", "ok"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": ["string", "null"]},
    "ok": {"type": "boolean"}
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}, "result": {"oneOf": [{"$ref": "#/$defs/init"}, {"$ref": "#/$defs/lease"}, {"$ref": "#/$defs/release"}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/leases"}, {"$ref": "#/$defs/user_config"}, {"$ref": "#/$defs/snapshot_result"}]}}, "required": ["result"], "not": {"required": ["error"]}},
    {"properties": {"ok": {"const": false}, "error": {"$ref": "#/$defs/error"}}, "required": ["error"], "not": {"required": ["result"]}}
  ],
  "$defs": {
    "slot": {"type": "string", "pattern": "^wt-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "policy": {"enum": ["pristine", "warm"]},
    "init": {
      "type": "object",
      "required": ["created", "common_git_dir", "state_dir", "capacity", "slots", "cleanup_policy", "worktree_root"],
      "properties": {
        "created": {"type": "boolean"}, "common_git_dir": {"type": "string"}, "state_dir": {"type": "string"},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 4096},
        "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}, "uniqueItems": true},
        "cleanup_policy": {"$ref": "#/$defs/policy"}, "worktree_root": {"type": "string"}
      }
    },
    "lease": {
      "type": "object",
      "required": ["slot_id", "lease_id", "worktree_path", "base_oid", "head_mode", "recovery", "cleanup_policy", "lease_transport", "descriptor_count"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/slot"}, "lease_id": {"$ref": "#/$defs/uuid"},
        "worktree_path": {"type": "string"}, "base_oid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "head_mode": {"const": "detached"}, "recovery": {"enum": ["created", "sanitized", "rebuilt"]},
        "cleanup_policy": {"$ref": "#/$defs/policy"}, "lease_transport": {"enum": ["scm_rights", "in_process", "durable_protection"]},
        "descriptor_count": {"enum": [0, 1]}
      },
      "allOf": [{"if": {"properties": {"lease_transport": {"const": "durable_protection"}}}, "then": {"properties": {"descriptor_count": {"const": 0}}}, "else": {"properties": {"descriptor_count": {"const": 1}}}}]
    },
    "leases": {
      "type": "object", "required": ["leases"],
      "properties": {"leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}}}
    },
    "release": {
      "type": "object", "required": ["slot_id", "lease_id", "released", "cleanup"],
      "properties": {"slot_id": {"$ref": "#/$defs/slot"}, "lease_id": {"$ref": "#/$defs/uuid"}, "released": {"const": true}, "cleanup": {"const": "deferred"}}
    },
    "user_config": {"type": "object", "required": ["config_path"], "properties": {"config_path": {"type": "string"}, "updated": {"const": true}, "config": {"type": "object"}, "environment_overrides": {"type": "object"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["version", "id", "created_at", "created_at_ns", "description", "workspace", "branch", "head", "index_tree", "work_tree", "untracked_blob", "session", "pinned"], "properties": {"version": {"const": 1}, "id": {"$ref": "#/$defs/uuid"}, "created_at": {"type": "integer", "minimum": 0}, "created_at_ns": {"type": "integer", "minimum": 0}, "description": {"type": "string"}, "workspace": {"type": "string"}, "branch": {"type": ["string", "null"]}, "head": {"type": ["string", "null"]}, "index_tree": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, "work_tree": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, "untracked_blob": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}, "session": {"type": ["string", "null"]}, "pinned": {"type": "boolean"}}},
    "snapshot_result": {"type": "object", "required": ["snapshot_result", "elapsed_ms"], "properties": {"snapshot_result": {"oneOf": [{"type": "object", "required": ["snapshot"], "properties": {"snapshot": {"$ref": "#/$defs/snapshot"}}}, {"type": "object", "required": ["snapshots"], "properties": {"snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}}}}, {"type": "object", "required": ["patch"], "properties": {"patch": {"type": "string"}}}, {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}, {"type": "object", "required": ["deleted"], "properties": {"deleted": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}}}, {"type": "object", "required": ["selected"], "properties": {"selected": {"type": "array", "items": {"$ref": "#/$defs/uuid"}}}}, {"type": "object", "required": ["retention"], "properties": {"retention": {"type": "object"}}}, {"type": "object", "required": ["compacted"], "properties": {"compacted": {"const": true}}}]}, "elapsed_ms": {"type": "integer", "minimum": 0}}},
    "text": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}},
    "error": {
      "type": "object", "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENT", "UNSUPPORTED_CONFIGURATION", "POOL_EXHAUSTED", "ACQUIRE_TIMEOUT", "NOT_INITIALIZED", "CONFIG_CONFLICT", "INVALID_REVISION", "INVALID_LEASE", "LEASE_MISMATCH", "RECOVERY_FAILED", "POOL_UNHEALTHY", "IO_ERROR", "GIT_ERROR", "PROTOCOL_ERROR"]},
        "message": {"type": "string"}, "retryable": {"type": "boolean"}, "details": {"type": "object"}
      }
    }
  }
}
